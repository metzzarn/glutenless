{
  "name": "glutenless",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/lora": "^0.4.2",
    "@expo-google-fonts/nunito-sans": "^0.4.2",
    "@react-native-ml-kit/text-recognition": "^2.0.0",
    "expo": "~57.0.4",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "~57.0.1",
    "expo-constants": "~57.0.3",
    "expo-font": "~57.0.0",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.2",
    "expo-router": "~57.0.4",
    "expo-speech-recognition": "^56.0.1",
    "expo-sqlite": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "build:android": "./scripts/build-android.sh",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "stamp-data": "node tools/stamp-data.mjs"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": ["expo-camera"]
      }
    }
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^expo-sqlite/kv-store$": "<rootDir>/__mocks__/expo-sqlite-kv-store.ts"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/tools/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/tools/ocr-bench/.cache/"
    ]
  }
}
